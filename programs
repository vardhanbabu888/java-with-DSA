## spy number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int a = obj.nextInt();
        int sum=0;
        int digits=1;
        while(a>0){
            int num = a%10;
            sum +=num;
            digits*=num;
            a/=10;
        }
        if(sum==digits){
            System.out.println("spy number");
        }else{
            System.out.println("not spy number");
        }
    }
}



